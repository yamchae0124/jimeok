# 비밀키·생성물·캐시는 git에 올리지 않음 (Z-021 PII/키 방어선)
.env
data/
map_data.js
# 지역 번들은 커밋 대상 — GitHub Actions 조립용, --nosite 재생성분 (T15)
!regions/*/map_data.js
# 데모 번들은 커밋 대상 — --nosite 빌드라 사업지 주소·좌표 0 (T13)
!demo/map_data.js
# 루트 단일지역 데이터 = 로컬 작업 파일, 사업지 포함 가능 — 공개용은 demo/
# (/ 앵커 = 루트만 매칭: demo/의 동명 sanitize 사본이 무시되지 않게)
/infra.js
/infra_icons.js
/transit.js
/district.js
/admin.js
/lh.js
/commute.js
/gdc_data.js
map_data.json
__pycache__/
*.pyc
_tmp_cap/

# 공개 레포 hygiene (jimeok 배포 준비 — T2)
# 사업지 주소·키 포함 로컬 전용 파일은 공개 레포에 올리지 않음
config.json
_config.py
.env.example
_deploy/
_archive/
PAGE/
_output/
_*.md
_*.html
